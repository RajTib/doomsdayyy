# Copy this file to .env and fill in NTFY_TOPIC. .env is git-ignored.

# --- Phone alerts via ntfy (free, no account) -------------------------------
# 1. Install the "ntfy" app on your phone (Android / iPhone).
# 2. In the app tap "+" and subscribe to a topic name that only you know.
# 3. Put exactly that name below. Anyone who guesses it can read your alerts,
#    so make it long and random, e.g. doomsday-kanpur-x7q2m9
NTFY_TOPIC=

# --- Optional: also send an SMS via Twilio (needs `pip install twilio`) ------
# Not recommended in India: it needs a paid number and DLT/compliance registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_TO=

# --- Optional overrides (defaults shown) -------------------------------------
CITY=kanpur
MOVIE_QUERY=avengers doomsday
TARGET_DATE=2026-12-25
# Set to 1 to also get a daily "still not open" alert
DAILY_STATUS_SMS=0
