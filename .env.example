# Copy this file to .env and fill in the Twilio values. .env is git-ignored.

# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, E.164 format
TWILIO_FROM=+1XXXXXXXXXX
# Where alerts go (on a Twilio trial account this number must be verified), E.164 format
ALERT_TO=+91XXXXXXXXXX

# Optional overrides (defaults shown)
CITY=kanpur
MOVIE_QUERY=avengers doomsday
TARGET_DATE=2026-12-25
# Set to 1 to also get a daily "still not open" status text
DAILY_STATUS_SMS=0
